#!/usr/bin/env bash

# Set strict mode
set -euo pipefail

# Initialize global variables
quiet=false
process=""

# Function to print usage information
usage() {
  cat <<EOF
Usage: omr [options] [process]

Options:
  -h, --help               Show this help message and exit
  -q, --quiet              Suppress non-error output
  -b, --branch             Manually specify branch
  -s, --status             Print out currently used branches for each service

Process:
  rails   Restart Rails and worker processes
  app     Restart the app process
  all     Restart all processes
  If not specified, the process will be auto-detected based on the repository structure.

Environment variables:
  FIRST_ROOT_DIR  The root directory for the project (required)
  FIRST_API_DIR   The API directory name (default: api)
  FIRST_NUXT_DIR  The Nuxt directory name (default: app)

Examples:
  omr -h        # Show help
  omr           # Auto-detect and restart
  omr app       # Restart the app process
  omr all       # Restart all processes
  omr -q rails  # Restart Rails with suppressed output
  omr -b main   # Restart auto-detected process with the main branch
EOF
}

# Function to set up color output
setup_colors() {
  if [[ -t 1 ]]; then
    GREEN=$(tput setaf 2)
    BLUE=$(tput setaf 4)
    MAGENTA=$(tput setaf 5)
    BOLD=$(tput bold)
    RESET=$(tput sgr0)
  else
    GREEN="" BLUE="" MAGENTA="" BOLD="" RESET=""
  fi
}

# Function for controlled output
output() {
  if [ "$quiet" = false ]; then
    echo "$@"
  fi
}

# Function to print error messages
error() {
  echo "ERROR: $*" >&2
}

# Function to parse command line arguments
parse_arguments() {
  while [[ $# -gt 0 ]]; do
    case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -q | --quiet)
      quiet=true
      shift
      ;;
    -b | --branch)
      SPECIFIED_BRANCH="$2"
      shift
      shift
      ;;
    -s | --status)
      status
      exit 0
      ;;
    *)
      if [[ -z $process ]]; then
        process=$1
      else
        error "Unknown argument: $1"
        usage
        exit 1
      fi
      shift
      ;;
    esac
  done
}

# Main function to restart Overmind process
restart() {
  local git_branch_path
  local branch

  # Use specified branch or detect from current directory
  if [[ -n "${SPECIFIED_BRANCH:-}" ]]; then
    branch="$SPECIFIED_BRANCH"
    # Find the worktree for the specified branch
    git_branch_path=$(git worktree list | grep "\[$SPECIFIED_BRANCH\]" | awk '{print $1}')
    if [[ -z "$git_branch_path" ]]; then
      error "No worktree found for branch: $SPECIFIED_BRANCH"
      return 1
    fi
  else
    git_branch_path=$(git rev-parse --show-toplevel 2>/dev/null)
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  fi

  # Check if we're in a git repository
  if [[ -z "$git_branch_path" || -z "$branch" ]]; then
    error "Not in a git repository"
    return 1
  fi

  # Check if FIRST_ROOT_DIR is set and valid (including symlinks)
  if [[ -z "${FIRST_ROOT_DIR:-}" || ! -e "$FIRST_ROOT_DIR" || ! -d "$FIRST_ROOT_DIR" ]]; then
    error "\$FIRST_ROOT_DIR is not set, does not exist, or is not a directory"
    return 1
  fi

  # Detect process if not specified
  if [[ -z $process ]]; then
    if [[ -f "$git_branch_path/nuxt.config.ts" ]]; then
      process="app"
    elif [[ -f "$git_branch_path/config/application.rb" ]]; then
      process="rails"
    else
      error "Unable to detect process. Please specify: rails or app"
      usage
      return 1
    fi
  fi

  # Print info
  output "Issuing a ${MAGENTA}${BOLD}overmind restart $process${RESET} for:"
  output -e "  ${BOLD}Branch:${RESET} ${GREEN}$branch${RESET}"
  output -e "  ${BOLD}Path:${RESET}   ${BLUE}$git_branch_path${RESET}"

  # Perform the restart
  case "$process" in
  rails | worker)
    (cd "$FIRST_ROOT_DIR" && ln -sfn "$git_branch_path" "$FIRST_API_DIR" && overmind restart rails worker)
    ;;
  app)
    (cd "$FIRST_ROOT_DIR" && ln -sfn "$git_branch_path" "$FIRST_NUXT_DIR" && overmind restart app)
    ;;
  all)
    (
      cd "$FIRST_ROOT_DIR" &&
        ln -sfn "$git_branch_path" "$FIRST_API_DIR" &&
        ln -sfn "$git_branch_path" "$FIRST_NUXT_DIR" &&
        overmind restart app rails worker
    )
    ;;
  *)
    error "Unhandled process argument: $process"
    usage
    return 1
    ;;
  esac
}

status() {
  setup_colors

  # Check if FIRST_ROOT_DIR is set
  if [[ -z "${FIRST_ROOT_DIR:-}" || ! -d "$FIRST_ROOT_DIR" ]]; then
    error "\$FIRST_ROOT_DIR is not set or is not a directory"
    return 1
  fi

  local api_dir="${FIRST_ROOT_DIR}/${FIRST_API_DIR:-api}"
  local nuxt_dir="${FIRST_ROOT_DIR}/${FIRST_NUXT_DIR:-app}"

  # Rails/API status
  if [[ -L "$api_dir" ]]; then
    local api_path=$(readlink -f "$api_dir")
    local api_branch=$(cd "$api_path" 2>/dev/null && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    output "${MAGENTA}${BOLD}rails${RESET} status:"
    output -e "  ${BOLD}Branch:${RESET} ${GREEN}${api_branch}${RESET}"
    output -e "  ${BOLD}Path:${RESET}   ${BLUE}${api_path}${RESET}"
  else
    output "${MAGENTA}${BOLD}rails${RESET} status: ${BOLD}not linked${RESET}"
  fi

  output ""

  # App/Nuxt status
  if [[ -L "$nuxt_dir" ]]; then
    local nuxt_path=$(readlink -f "$nuxt_dir")
    local nuxt_branch=$(cd "$nuxt_path" 2>/dev/null && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    output "${MAGENTA}${BOLD}app${RESET} status:"
    output -e "  ${BOLD}Branch:${RESET} ${GREEN}${nuxt_branch}${RESET}"
    output -e "  ${BOLD}Path:${RESET}   ${BLUE}${nuxt_path}${RESET}"
  else
    output "${MAGENTA}${BOLD}app${RESET} status: ${BOLD}not linked${RESET}"
  fi
}

main() {
  setup_colors

  if [[ $# -gt 0 ]]; then
    parse_arguments "$@"
  fi

  restart
}

main "$@"
