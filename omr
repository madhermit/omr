#!/usr/bin/env bash
set -euo pipefail

# Defaults
FIRST_API_DIR="${FIRST_API_DIR:-api}"
FIRST_NUXT_DIR="${FIRST_NUXT_DIR:-app}"
quiet=false
process=""
branch=""

die() { echo "ERROR: $*" >&2; exit 1; }
log() { [[ $quiet == true ]] || echo "$@"; }

setup_colors() {
  if [[ -t 1 ]]; then
    GREEN=$(tput setaf 2) BLUE=$(tput setaf 4) MAGENTA=$(tput setaf 5)
    BOLD=$(tput bold) RESET=$(tput sgr0)
  else
    GREEN="" BLUE="" MAGENTA="" BOLD="" RESET=""
  fi
}

usage() {
  cat <<EOF
Usage: omr [options] [process]

Options:
  -h, --help      Show this help message
  -q, --quiet     Suppress output
  -b, --branch    Use specified branch's worktree
  -s, --status    Show current service branches

Process:
  rails   Restart Rails and worker processes
  app     Restart the app process
  all     Restart all processes

Environment:
  FIRST_ROOT_DIR  Root directory (required)
  FIRST_API_DIR   API directory name (default: api)
  FIRST_NUXT_DIR  Nuxt directory name (default: app)

Examples:
  omr              # Auto-detect and restart
  omr app          # Restart app process
  omr all          # Restart all processes
  omr -b main      # Use main branch's worktree
  omr -q rails     # Quiet mode
EOF
}

require_root_dir() {
  [[ -n "${FIRST_ROOT_DIR:-}" && -d "$FIRST_ROOT_DIR" ]] ||
    die "\$FIRST_ROOT_DIR is not set or is not a directory"
}

resolve_worktree_path() {
  if [[ -n "$branch" ]]; then
    git worktree list | awk -v b="[$branch]" '$0 ~ b {print $1; exit}'
  else
    git rev-parse --show-toplevel 2>/dev/null
  fi
}

detect_process() {
  local path="$1"
  if [[ -f "$path/nuxt.config.ts" ]]; then
    echo "app"
  elif [[ -f "$path/config/application.rb" ]]; then
    echo "rails"
  fi
}

print_service_status() {
  local name="$1" dir="$2"
  if [[ -L "$dir" ]]; then
    local path svc_branch
    path=$(readlink -f "$dir")
    svc_branch=$(cd "$path" && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    log "${MAGENTA}${BOLD}${name}${RESET}:"
    log "  Branch: ${GREEN}${svc_branch}${RESET}"
    log "  Path:   ${BLUE}${path}${RESET}"
  else
    log "${MAGENTA}${BOLD}${name}${RESET}: not linked"
  fi
}

cmd_status() {
  setup_colors
  require_root_dir
  print_service_status "rails" "${FIRST_ROOT_DIR}/${FIRST_API_DIR}"
  log ""
  print_service_status "app" "${FIRST_ROOT_DIR}/${FIRST_NUXT_DIR}"
}

cmd_restart() {
  setup_colors
  require_root_dir

  local worktree_path
  worktree_path=$(resolve_worktree_path)
  [[ -n "$worktree_path" ]] || die "Could not resolve git worktree${branch:+ for branch: $branch}"

  [[ -n "$branch" ]] || branch=$(cd "$worktree_path" && git rev-parse --abbrev-ref HEAD)

  if [[ -z "$process" ]]; then
    process=$(detect_process "$worktree_path")
    [[ -n "$process" ]] || die "Unable to detect process type. Specify: rails, app, or all"
  fi

  log "Restarting ${MAGENTA}${BOLD}${process}${RESET}:"
  log "  Branch: ${GREEN}${branch}${RESET}"
  log "  Path:   ${BLUE}${worktree_path}${RESET}"

  cd "$FIRST_ROOT_DIR"
  case "$process" in
    rails|worker)
      ln -sfn "$worktree_path" "$FIRST_API_DIR"
      overmind restart rails worker
      ;;
    app)
      ln -sfn "$worktree_path" "$FIRST_NUXT_DIR"
      overmind restart app
      ;;
    all)
      ln -sfn "$worktree_path" "$FIRST_API_DIR"
      ln -sfn "$worktree_path" "$FIRST_NUXT_DIR"
      overmind restart app rails worker
      ;;
    *) die "Unknown process: $process" ;;
  esac
}

main() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--help) usage; exit 0 ;;
      -q|--quiet) quiet=true; shift ;;
      -b|--branch)
        [[ -n "${2:-}" ]] || die "-b requires a branch name"
        branch="$2"; shift 2
        ;;
      -s|--status) cmd_status; exit 0 ;;
      -*)  die "Unknown option: $1" ;;
      *)
        [[ -z "$process" ]] || die "Unexpected argument: $1"
        process="$1"; shift
        ;;
    esac
  done

  cmd_restart
}

main "$@"
